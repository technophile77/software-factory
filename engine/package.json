{
  "name": "software-factory-engine",
  "description": "The software factory engine (F-007, milestone 1).",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/engine.js",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node22 --external:koffi --outfile=dist/engine.js && esbuild src/proxy/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/proxy.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/acceptance",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "koffi": "3.3.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.2",
    "vitest": "5.1.0"
  }
}
