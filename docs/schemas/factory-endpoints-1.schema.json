{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,32}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 2000
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "api": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ]
          },
          "api_key_ref": {
            "type": "string",
            "maxLength": 100
          },
          "max_sessions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "billing": {
            "type": "string",
            "enum": [
              "local",
              "per_token",
              "subscription"
            ]
          },
          "deadline": {
            "type": "object",
            "properties": {
              "margin_s": {
                "type": "integer",
                "minimum": 10,
                "maximum": 3600
              }
            },
            "required": [
              "margin_s"
            ],
            "additionalProperties": false
          },
          "allow_loopback": {
            "type": "boolean"
          },
          "prices": {
            "type": "object",
            "properties": {
              "input_per_mtok": {
                "type": "number",
                "minimum": 0
              },
              "output_per_mtok": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "input_per_mtok",
              "output_per_mtok"
            ],
            "additionalProperties": false
          },
          "plan": {
            "type": "object",
            "properties": {
              "limits": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "requests",
                        "input_tokens",
                        "output_tokens"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "window": {
                      "type": "string",
                      "enum": [
                        "5h",
                        "day",
                        "week",
                        "month"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "count",
                    "window"
                  ],
                  "additionalProperties": false
                }
              },
              "reserve_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              }
            },
            "required": [
              "limits"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "base_url",
          "model",
          "api",
          "billing"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "endpoints"
  ],
  "additionalProperties": false
}
