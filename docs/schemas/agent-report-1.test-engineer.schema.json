{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-report/1.0"
    },
    "role": {
      "type": "string",
      "const": "test-engineer"
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "stage": {
      "type": "string",
      "maxLength": 60
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "body": {
      "type": "object",
      "properties": {
        "criteria_map": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^AC-\\d{1,3}$"
          },
          "additionalProperties": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "tool_choices": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_type": {
                "type": "string",
                "maxLength": 100
              },
              "tool": {
                "type": "string",
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "approval_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "test_type",
              "tool",
              "reason",
              "approval_ref"
            ],
            "additionalProperties": false
          }
        },
        "ci_only": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test": {
                "type": "string",
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "test",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "ci_jobs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "job": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "update",
                  "remove"
                ]
              },
              "template": {
                "type": "string",
                "enum": [
                  "test-command",
                  "coverage",
                  "gitleaks",
                  "semgrep",
                  "osv-scanner"
                ]
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "covers": {
                "default": [],
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "repo",
              "job",
              "action",
              "covers",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "criteria_map",
        "tool_choices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "role",
    "feature",
    "stage",
    "commit",
    "outcome",
    "summary",
    "body"
  ],
  "additionalProperties": false
}
