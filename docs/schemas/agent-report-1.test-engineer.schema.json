{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-report/1.0"
    },
    "role": {
      "type": "string",
      "const": "test-engineer"
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "stage": {
      "type": "string",
      "maxLength": 60
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "body": {
      "type": "object",
      "properties": {
        "tests_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "criteria_map": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^AC-\\d{1,3}$"
          },
          "additionalProperties": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "failures": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test": {
                "type": "string",
                "maxLength": 300
              },
              "expected": {
                "type": "string",
                "maxLength": 2000
              },
              "actual": {
                "type": "string",
                "maxLength": 2000
              },
              "log_ref": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "test",
              "expected",
              "actual",
              "log_ref"
            ],
            "additionalProperties": false
          }
        },
        "not_run": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test": {
                "type": "string",
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "test",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "tool_choices": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_type": {
                "type": "string",
                "maxLength": 100
              },
              "tool": {
                "type": "string",
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "approval_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "test_type",
              "tool",
              "reason",
              "approval_ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tests_run",
        "passed",
        "failed",
        "skipped",
        "criteria_map",
        "failures",
        "not_run",
        "tool_choices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "role",
    "feature",
    "stage",
    "commit",
    "outcome",
    "summary",
    "body"
  ],
  "additionalProperties": false
}
