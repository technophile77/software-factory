{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "factory-lease/1.0"
    },
    "factory": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "started": {
      "type": "string",
      "maxLength": 40
    },
    "renewed": {
      "type": "string",
      "maxLength": 40
    }
  },
  "required": [
    "schema",
    "factory",
    "started",
    "renewed"
  ],
  "additionalProperties": false
}
