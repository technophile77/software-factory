{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "calibration-result/1.0"
    },
    "reason": {
      "type": "string",
      "enum": [
        "initial",
        "owner_request",
        "step_down_check"
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 100
    },
    "ladder_version": {
      "type": "string",
      "maxLength": 100
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "actual_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "stopped_at_cap": {
      "type": "boolean"
    },
    "roles": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 60
          },
          "tried": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rung": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "trials": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "passes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "rung",
                "trials",
                "passes",
                "tokens",
                "cost_usd",
                "passed"
              ],
              "additionalProperties": false
            }
          },
          "proposed_rung": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "role",
          "tried",
          "proposed_rung"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "reason",
    "source",
    "ladder_version",
    "estimated_cost_usd",
    "actual_cost_usd",
    "stopped_at_cap",
    "roles"
  ],
  "additionalProperties": false
}
