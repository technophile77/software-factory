{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "inbox-private/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[DTHSMN]-\\d{4,}$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sections": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 40000
          }
        },
        "required": [
          "name",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "rev",
    "sections"
  ],
  "additionalProperties": false
}
