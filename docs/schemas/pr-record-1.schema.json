{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "pr-record/1.0"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}\\/[A-Za-z0-9_.-]{1,100}$"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "evidence_comment_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "history": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "maxLength": 40
              },
              "action": {
                "type": "string",
                "const": "evidence_posted"
              },
              "comment_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              }
            },
            "required": [
              "at",
              "action",
              "comment_id",
              "head"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "maxLength": 40
              },
              "action": {
                "type": "string",
                "const": "changes_requested"
              },
              "comment_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "actor_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "at",
              "action",
              "comment_id",
              "actor_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "maxLength": 40
              },
              "action": {
                "type": "string",
                "const": "merged_on_github"
              },
              "merge_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              "merged_by": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "at",
              "action",
              "merge_commit",
              "merged_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "maxLength": 40
              },
              "action": {
                "type": "string",
                "const": "closed_on_github"
              }
            },
            "required": [
              "at",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "repo",
    "number",
    "feature",
    "history"
  ],
  "additionalProperties": false
}
