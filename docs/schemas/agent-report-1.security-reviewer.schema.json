{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-report/1.0"
    },
    "role": {
      "type": "string",
      "const": "security-reviewer"
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "stage": {
      "type": "string",
      "maxLength": 60
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "body": {
      "type": "object",
      "properties": {
        "gate": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "findings": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "pattern": "^[SP]\\d{1,2}(\\.\\d{1,2})?$"
              },
              "severity": {
                "type": "string",
                "maxLength": 20
              },
              "location": {
                "type": "string",
                "maxLength": 500
              },
              "explanation": {
                "type": "string",
                "maxLength": 4000
              },
              "fix": {
                "type": "string",
                "maxLength": 4000
              },
              "needs_owner": {
                "type": "boolean"
              },
              "options": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "recommendation": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            },
            "required": [
              "criterion",
              "severity",
              "location",
              "explanation",
              "fix"
            ],
            "additionalProperties": false
          }
        },
        "checklist": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "maxLength": 500
              },
              "answer": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "permissions_added": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "abuse_cases": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "not_applicable": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "pattern": "^[SP]\\d{1,2}(\\.\\d{1,2})?$"
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "criterion",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "gate",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "role",
    "feature",
    "stage",
    "commit",
    "outcome",
    "summary",
    "body"
  ],
  "additionalProperties": false
}
