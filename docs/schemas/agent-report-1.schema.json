{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-report/1.0"
    },
    "role": {
      "type": "string",
      "maxLength": 60
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "stage": {
      "type": "string",
      "maxLength": 60
    },
    "commit": {
      "type": "string",
      "maxLength": 64
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "body": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "items_filed": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[DTHSMN]-\\d{4,}$"
      }
    },
    "artifacts": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "ref": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "model": {
      "type": "string",
      "maxLength": 200
    },
    "effort": {
      "type": "string",
      "maxLength": 20
    },
    "rung": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "plan_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "duration_s"
      ],
      "additionalProperties": false
    },
    "transcript_ref": {
      "type": "string",
      "maxLength": 2000
    },
    "fallback": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 60
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        },
        "waited_s": {
          "type": "number",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "endpoint",
        "reason",
        "waited_s",
        "prompt_tokens"
      ],
      "additionalProperties": false
    },
    "advisory": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "endpoint_rates": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "report_via": {
      "type": "string",
      "enum": [
        "structured_output",
        "file"
      ]
    }
  },
  "required": [
    "schema",
    "role",
    "feature",
    "stage",
    "commit",
    "outcome",
    "summary",
    "body",
    "items_filed",
    "artifacts"
  ],
  "additionalProperties": false
}
