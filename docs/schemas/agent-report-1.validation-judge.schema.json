{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-report/1.0"
    },
    "role": {
      "type": "string",
      "const": "validation-judge"
    },
    "feature": {
      "type": "string",
      "pattern": "^F-\\d{3,6}$"
    },
    "stage": {
      "type": "string",
      "maxLength": 60
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "body": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NEEDS_HUMAN_REVIEW"
          ]
        },
        "checklist": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "area": {
                "type": "string",
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "maxLength": 40
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "area",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "grade": {
                "type": "string",
                "maxLength": 40
              },
              "location": {
                "type": "string",
                "maxLength": 500
              },
              "explanation": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "grade",
              "location",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "verdict",
        "checklist",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "role",
    "feature",
    "stage",
    "commit",
    "outcome",
    "summary",
    "body"
  ],
  "additionalProperties": false
}
