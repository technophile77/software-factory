{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mcp-server-record/1.1",
        "mcp-server-record/1.0"
      ]
    },
    "server": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "package",
        "command",
        "remote"
      ]
    },
    "ecosystem": {
      "type": "string",
      "enum": [
        "npm",
        "pypi"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 214
    },
    "version": {
      "type": "string",
      "maxLength": 100
    },
    "lockfile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url": {
      "type": "string",
      "maxLength": 500
    },
    "install_scripts": {
      "type": "boolean"
    },
    "cve_scan": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "maxLength": 100
        },
        "ran_at": {
          "type": "string",
          "maxLength": 40
        },
        "critical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "high": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "medium": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "low": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tool",
        "ran_at",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "additionalProperties": false
    },
    "tools": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "class": {
            "type": "string",
            "enum": [
              "reads",
              "acts"
            ]
          },
          "description_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "risk": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "name",
          "class",
          "description_sha256"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "receives": {
          "type": "string",
          "maxLength": 2000
        },
        "sends_to": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]{1,253}$"
          }
        },
        "leaves_pc": {
          "type": "boolean"
        }
      },
      "required": [
        "receives",
        "sends_to",
        "leaves_pc"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "string",
      "maxLength": 300
    },
    "approved": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "maxLength": 40
        },
        "local_risk_accepted": {
          "type": "boolean"
        },
        "choice": {
          "type": "string",
          "enum": [
            "A",
            "C"
          ]
        }
      },
      "required": [
        "item",
        "at",
        "local_risk_accepted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "server",
    "kind",
    "install_scripts",
    "tools",
    "data",
    "review",
    "approved"
  ],
  "additionalProperties": false
}
