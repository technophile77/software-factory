{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "advisor-answer/1.0"
    },
    "findings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "source": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "text",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "trade_offs": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "label",
          "trade_offs"
        ],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "option": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "reasoning": {
          "type": "string",
          "maxLength": 4000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "option",
        "reasoning",
        "confidence"
      ],
      "additionalProperties": false
    },
    "risks": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "source_contains_instructions": {
      "type": "boolean"
    },
    "where": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "schema",
    "findings",
    "options",
    "recommendation",
    "risks",
    "source_contains_instructions"
  ],
  "additionalProperties": false
}
