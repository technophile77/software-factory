{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "console-answer/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[DTHSMN]-\\d{4,}$"
    },
    "n": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action": {
      "type": "string",
      "maxLength": 40
    },
    "note": {
      "type": "string",
      "maxLength": 4000
    },
    "at": {
      "type": "string",
      "maxLength": 40
    },
    "session": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "id",
    "n",
    "rev",
    "action",
    "at",
    "session",
    "entry_sha256"
  ],
  "additionalProperties": false
}
